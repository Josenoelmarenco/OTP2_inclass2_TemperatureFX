<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Two layers of localization meet in this view:

    * every STATIC label uses the %key syntax, so it is translated by loading
      this file with a different ResourceBundle;
    * every UNIT NAME and DESCRIPTION is left empty here on purpose and filled
      by MainController from the database, in the selected language.

  No user-visible text is hard-coded in this file.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fi.metropolia.tempfx.ui.MainController"
            stylesheets="@styles.css"
            styleClass="root-pane"
            prefWidth="1040.0" prefHeight="820.0">

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>
            <children>
                <Label text="%app.title" styleClass="app-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%label.language" styleClass="field-label"/>
                <ComboBox fx:id="languageComboBox" prefWidth="160.0"/>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="18.0">
                    <padding>
                        <Insets top="18.0" right="20.0" bottom="12.0" left="20.0"/>
                    </padding>
                    <children>

                        <!-- Temperature conversion. The unit names and the two
                             description labels are filled from the database. -->
                        <VBox spacing="12.0" styleClass="card">
                            <children>
                                <Label text="%section.temperature" styleClass="section-title"/>
                                <Label text="%section.temperature.hint" styleClass="section-hint" wrapText="true"/>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%label.value" styleClass="field-label"/>
                                        <TextField fx:id="temperatureField" prefWidth="120.0"/>
                                        <Label text="%label.from" styleClass="field-label"/>
                                        <ComboBox fx:id="fromUnitComboBox" prefWidth="210.0"/>
                                        <Label text="%label.to" styleClass="field-label"/>
                                        <ComboBox fx:id="toUnitComboBox" prefWidth="210.0"/>
                                        <Button fx:id="convertButton" text="%button.convert"
                                                styleClass="primary-button" onAction="#handleConvert"/>
                                    </children>
                                </HBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label fx:id="fromDescriptionLabel" styleClass="unit-description" wrapText="true"/>
                                        <Label fx:id="toDescriptionLabel" styleClass="unit-description" wrapText="true"/>
                                    </children>
                                </VBox>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%label.result" styleClass="field-label"/>
                                        <Label fx:id="resultLabel" styleClass="result-value"/>
                                        <Label fx:id="extremeLabel" styleClass="badge"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- The last five conversions, read back from conversion_log
                             with the unit names localized at query time. -->
                        <VBox spacing="12.0" styleClass="card">
                            <children>
                                <Label text="%section.history" styleClass="section-title"/>
                                <TableView fx:id="historyTable" prefHeight="190.0">
                                    <columns>
                                        <TableColumn fx:id="historyInputColumn" text="%table.input" prefWidth="110.0"/>
                                        <TableColumn fx:id="historyFromColumn" text="%table.fromUnit" prefWidth="200.0"/>
                                        <TableColumn fx:id="historyToColumn" text="%table.toUnit" prefWidth="200.0"/>
                                        <TableColumn fx:id="historyResultColumn" text="%table.result" prefWidth="110.0"/>
                                        <TableColumn fx:id="historyLanguageColumn" text="%table.language" prefWidth="110.0"/>
                                        <TableColumn fx:id="historyWhenColumn" text="%table.when" prefWidth="190.0"/>
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Trip log stored in the two related measurement tables -->
                        <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="%section.trips" styleClass="section-title"/>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%label.tripLabel" styleClass="field-label"/>
                                        <TextField fx:id="tripLabelField" prefWidth="180.0"/>
                                        <Label text="%label.distance" styleClass="field-label"/>
                                        <TextField fx:id="distanceField" prefWidth="90.0"/>
                                        <Label text="%label.time" styleClass="field-label"/>
                                        <TextField fx:id="timeField" prefWidth="90.0"/>
                                        <Label text="%label.unitSystem" styleClass="field-label"/>
                                        <ComboBox fx:id="unitSystemComboBox" prefWidth="150.0"/>
                                    </children>
                                </HBox>
                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="%label.systemUnits" styleClass="field-label"/>
                                        <Label fx:id="systemUnitsLabel" styleClass="unit-description"/>
                                    </children>
                                </HBox>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button fx:id="addButton" text="%button.add"
                                                styleClass="primary-button" onAction="#handleAddTrip"/>
                                        <Button fx:id="deleteButton" text="%button.delete"
                                                onAction="#handleDeleteTrip"/>
                                        <Button fx:id="refreshButton" text="%button.refresh"
                                                onAction="#handleRefresh"/>
                                    </children>
                                </HBox>
                                <TableView fx:id="tripTable" prefHeight="200.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="labelColumn" text="%table.label" prefWidth="220.0"/>
                                        <TableColumn fx:id="distanceColumn" text="%table.distance" prefWidth="130.0"/>
                                        <TableColumn fx:id="timeColumn" text="%table.time" prefWidth="110.0"/>
                                        <TableColumn fx:id="speedColumn" text="%table.speed" prefWidth="140.0"/>
                                        <TableColumn fx:id="unitsColumn" text="%table.units" prefWidth="140.0"/>
                                        <TableColumn fx:id="createdColumn" text="%table.created" prefWidth="180.0"/>
                                    </columns>
                                </TableView>
                                <Label fx:id="statsLabel" styleClass="stats"/>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="20.0" bottom="8.0" left="20.0"/>
            </padding>
            <children>
                <Label fx:id="statusLabel" text="%status.ready"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
