<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Every visible text comes from the resource bundle through the %key syntax,
  so the whole layout is translated by loading this file with a different
  ResourceBundle. No text is hard-coded here.
-->
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fi.metropolia.tempfx.ui.MainController"
            stylesheets="@styles.css"
            styleClass="root-pane"
            prefWidth="1000.0" prefHeight="720.0">

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>
            <children>
                <Label text="%app.title" styleClass="app-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%label.language" styleClass="field-label"/>
                <ComboBox fx:id="languageComboBox" prefWidth="160.0"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="18.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>
            <children>

                <!-- Temperature conversion -->
                <VBox spacing="12.0" styleClass="card">
                    <children>
                        <Label text="%section.temperature" styleClass="section-title"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="%label.value" styleClass="field-label"/>
                                <TextField fx:id="temperatureField" prefWidth="120.0"/>
                                <Label text="%label.from" styleClass="field-label"/>
                                <ComboBox fx:id="fromUnitComboBox" prefWidth="150.0"/>
                                <Label text="%label.to" styleClass="field-label"/>
                                <ComboBox fx:id="toUnitComboBox" prefWidth="150.0"/>
                                <Button fx:id="convertButton" text="%button.convert"
                                        styleClass="primary-button" onAction="#handleConvert"/>
                            </children>
                        </HBox>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="%label.result" styleClass="field-label"/>
                                <Label fx:id="resultLabel" styleClass="result-value"/>
                                <Label fx:id="extremeLabel" styleClass="badge"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Trip log stored in the database -->
                <VBox spacing="12.0" styleClass="card" VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="%section.trips" styleClass="section-title"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="%label.tripLabel" styleClass="field-label"/>
                                <TextField fx:id="tripLabelField" prefWidth="180.0"/>
                                <Label text="%label.distance" styleClass="field-label"/>
                                <TextField fx:id="distanceField" prefWidth="90.0"/>
                                <Label text="%label.time" styleClass="field-label"/>
                                <TextField fx:id="timeField" prefWidth="90.0"/>
                                <Label text="%label.unitSystem" styleClass="field-label"/>
                                <ComboBox fx:id="unitSystemComboBox" prefWidth="150.0"/>
                            </children>
                        </HBox>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Button fx:id="addButton" text="%button.add"
                                        styleClass="primary-button" onAction="#handleAddTrip"/>
                                <Button fx:id="deleteButton" text="%button.delete"
                                        onAction="#handleDeleteTrip"/>
                                <Button fx:id="refreshButton" text="%button.refresh"
                                        onAction="#handleRefresh"/>
                            </children>
                        </HBox>
                        <TableView fx:id="tripTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="labelColumn" text="%table.label" prefWidth="220.0"/>
                                <TableColumn fx:id="distanceColumn" text="%table.distance" prefWidth="130.0"/>
                                <TableColumn fx:id="timeColumn" text="%table.time" prefWidth="110.0"/>
                                <TableColumn fx:id="speedColumn" text="%table.speed" prefWidth="140.0"/>
                                <TableColumn fx:id="unitsColumn" text="%table.units" prefWidth="140.0"/>
                                <TableColumn fx:id="createdColumn" text="%table.created" prefWidth="180.0"/>
                            </columns>
                        </TableView>
                        <Label fx:id="statsLabel" styleClass="stats"/>
                    </children>
                </VBox>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="8.0" right="20.0" bottom="8.0" left="20.0"/>
            </padding>
            <children>
                <Label fx:id="statusLabel" text="%status.ready"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
